        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - naswarden_pool_last_scrub_timestamp_seconds) / 86400",
          "legendFormat": "{{pool}}",
          "refId": "A",
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
