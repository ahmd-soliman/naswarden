      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(naswarden_source_stale) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
