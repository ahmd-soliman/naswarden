    {
      "id": 18,
      "type": "table",
      "title": "Replication tasks",
      "description": "Hours since each task last succeeded, and its current state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
