    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Disk errors in the last hour",
      "description": "ZFS read, write and checksum errors per pool member disk. Any line above 0 deserves a look; the counters reset when the pool is imported, and a drop (after a clear) is not shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, disk, type) (delta(naswarden_disk_errors[1h])) > 0",
          "legendFormat": "{{pool}} / {{disk}} ({{type}})",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
